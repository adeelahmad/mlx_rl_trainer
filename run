# --- Create Directory ---
mkdir -p src/mlx_rl_trainer/core

# --- Generate src/mlx_rl_trainer/core/dataset_manager.py (FIXED) ---
cat > ./src/mlx_rl_trainer/core/dataset_manager.py << 'EOF'
import asyncio
import gc
import json
import logging
import random
from collections import defaultdict
from pathlib import Path
from typing import Any, Callable, Dict, List, Optional
import importlib.util

import mlx.core as mx
from datasets import Dataset, Features, Value, Sequence
from tqdm.auto import tqdm

from mlx_rl_trainer.core.config import ExperimentConfig
from mlx_rl_trainer.core.exceptions import DataLoadError, InvalidConfigurationError
from mlx_rl_trainer.data.batch_builder import build_rollout_batch
from mlx_rl_trainer.utils.text_utils import (_contains_keywords,
                                            _mcq_meta_from_sample,
                                            clean_completion_string,
                                            _looks_garbage)

logger = logging.getLogger(__name__)


def _normalize_record(obj: Dict, prompt_key: str, completion_key: str) -> Optional[Dict]:
    if not isinstance(obj, dict): return None

    prompt = str(obj.get(prompt_key, obj.get("prompt", obj.get("question", ""))))
    completion = str(obj.get(completion_key, obj.get("completion", obj.get("answer", ""))))
    clean_completion = clean_completion_string(completion)
    
    meta = obj.get("meta", {})
    if not isinstance(meta, dict): meta = {"raw_meta": str(meta)}
    
    mcq_meta = _mcq_meta_from_sample({"prompt": prompt, "completion": clean_completion, "meta": meta})

    final_meta = mcq_meta.copy()
    final_meta.update({k: v for k, v in meta.items() if k not in mcq_meta})
    
    final_meta['mcq_options'] = final_meta.get('mcq_options') or []
    final_meta['mcq_correct_indices'] = final_meta.get('mcq_correct_indices') or []

    if "verifiable_answer_str" in obj:
        final_meta["verifiable_answer_str"] = obj["verifiable_answer_str"]

    final_meta["_original_sample"] = obj
    
    test_cases = obj.get("test_cases", [])
    if not isinstance(test_cases, list):
        test_cases = [test_cases] if test_cases is not None else []
    
    return {
        "prompt": prompt,
        "completion": clean_completion,
        "is_invalid_sample": obj.get("is_invalid_sample", False),
        "system": str(obj.get("system", "")),
        "test_cases": [json.dumps(tc, default=str) if isinstance(tc, dict) else str(tc) for tc in test_cases],
        "meta": final_meta,
    }

class DatasetManager:
    def __init__(self, config: ExperimentConfig):
        self.exp_config = config
        self.config = config.data
        self._tokenizer = None
        self._train_dataset: Optional[Dataset] = None
        self._val_dataset: Optional[Dataset] = None
        self._is_loaded = False
        self.validator_fn = self._load_validator()

    def _load_validator(self) -> Optional[Callable[[Dict], bool]]:
        script_path = self.config.data_validation_script_path
        if not script_path: return None
        if not script_path.exists(): raise InvalidConfigurationError(f"Data validation script not found: {script_path}")
        try:
            spec = importlib.util.spec_from_file_location("data_validator", script_path)
            module = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(module)
            if hasattr(module, "validate_sample"):
                logger.info(f"Loaded custom data validator from {script_path}")
                return getattr(module, "validate_sample")
            else:
                raise InvalidConfigurationError(f"Validator script {script_path} must have a 'validate_sample' function.")
        except Exception as e:
            raise InvalidConfigurationError(f"Failed to load data validator: {e}") from e

    def set_tokenizer(self, tokenizer): self._tokenizer = tokenizer
    def _aggressive_memory_cleanup(self): gc.collect()

    async def _read_data(self, path: Path, split_name: str) -> List[Dict]:
        if not path: return []
        
        if path.suffix.lower() in [".jsonl", ".ndjson"]:
            import aiofiles
            data = []
            logger.info(f"Manually parsing JSONL file: {path}")
            
            # **THE FIX**: Manually handle async iteration and progress bar
            with tqdm(desc=f"Reading {path.name}", unit=" lines") as pbar:
                async with aiofiles.open(path, mode="r", encoding="utf-8") as f:
                    line_num = 0
                    async for line in f:
                        line_num += 1
                        pbar.update(1)
                        if line.strip():
                            try:
                                data.append(json.loads(line))
                            except json.JSONDecodeError:
                                logger.warning(f"Skipping malformed JSON line {line_num} in {path.name}")
            return data
        else:
            from datasets import load_dataset
            try:
                logger.info(f"Loading from Hugging Face Hub: {path}")
                split = "train" if split_name == "train" else "test"
                return load_dataset(str(path), split=split).to_list()
            except Exception as e:
                raise DataLoadError(f"Failed to load dataset '{path}' from Hugging Face Hub: {e}") from e

    async def load_datasets(self, force_reload: bool = False):
        if self._is_loaded and not force_reload: return

        train_data = await self._read_data(self.config.train_path, "train")
        self._train_dataset = self._process_raw_to_dataset(train_data, "train")
        del train_data; self._aggressive_memory_cleanup()
        
        if self.config.val_path:
            val_data = await self._read_data(self.config.val_path, "val")
            self._val_dataset = self._process_raw_to_dataset(val_data, "val")
            del val_data; self._aggressive_memory_cleanup()
        else:
            self._val_dataset = None
            
        self._is_loaded = True
        logger.info(f"Datasets loaded. Train: {len(self._train_dataset)}, Val: {len(self._val_dataset) if self._val_dataset else 0}")
    
    def _process_raw_to_dataset(self, raw_data: List[Dict], split_name: str) -> Dataset:
        if not raw_data: return Dataset.from_dict({})

        processed_records = []
        for record in tqdm(raw_data, desc=f"Normalizing {split_name} data"):
            if self.validator_fn:
                is_valid = self.validator_fn(record)
                if not is_valid and self.config.data_validation_strict_mode: continue
                record["is_invalid_sample"] = not is_valid
            
            norm_rec = _normalize_record(record, self.config.dataset_prompt_key, self.config.dataset_answer_key)
            if norm_rec and not _looks_garbage(norm_rec["prompt"]):
                processed_records.append(norm_rec)

        if not processed_records: 
            logger.warning(f"No valid records for split '{split_name}' after processing.")
            return Dataset.from_dict({})

        columnar_data = defaultdict(list)
        if processed_records:
            all_keys = set().union(*(d.keys() for d in processed_records))
            for record in processed_records:
                for key in all_keys:
                    columnar_data[key].append(record.get(key))

        try:
            if 'meta' in columnar_data:
                columnar_data['meta'] = [json.dumps(m, default=str) for m in columnar_data['meta']]
            return Dataset.from_dict(dict(columnar_data))
        except Exception as e:
            logger.error(f"FATAL: Arrow dataset creation failed. Error: {e}", exc_info=True)
            raise DataLoadError("Dataset creation failed due to inconsistent data.") from e

    def get_dataloader(self, split: str, batch_size: int):
        dataset = self._train_dataset if split == "train" else self._val_dataset
        if not dataset or len(dataset) == 0:
            logger.warning(f"Dataloader for '{split}' is empty."); return iter([])

        if 'meta' in dataset.column_names and isinstance(dataset[0]['meta'], str):
             dataset = dataset.map(lambda x: {'meta': json.loads(x['meta'])})

        indices = list(range(len(dataset)))
        if self.config.shuffle_data and split == "train": random.shuffle(indices)

        def generator():
            for i in range(0, len(indices), batch_size):
                batch_indices = indices[i : i + batch_size]
                if not batch_indices: continue
                
                prompts_data, prompts_mx, _ = build_rollout_batch(self._tokenizer, dataset, batch_indices, self.exp_config)
                
                if prompts_mx.size > 0:
                    yield {"prompts_data": prompts_data, "prompts_mx": prompts_mx}
                
                if i > 0 and (i // batch_size) % 20 == 0: self._aggressive_memory_cleanup()
        
        return generator()
EOF

# --- Final Step: Summarize & Exit ---
echo ""
echo "-----------------------------------------------------"
echo "✅ src/mlx_rl_trainer/core/dataset_manager.py has been regenerated."
echo "   - Fix: Correctly implemented asynchronous file iteration with a manual"
echo "     progress bar to resolve the TypeError."
echo "-----------------------------------------------------"
